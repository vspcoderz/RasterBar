{
  "name": "RasterBar",
  "short_name": "RasterBar",
  "description": "YouTube in your terminal, and in this window.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#08080a",
  "theme_color": "#08080a",
  "categories": ["music", "video", "entertainment"],
  "icons": [
    { "src": "/assets/icons/app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
